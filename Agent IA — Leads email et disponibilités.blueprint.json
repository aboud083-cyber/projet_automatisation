        {
            "id": 3,
            "module": "ai-local-agent:RunLocalAIAgent",
            "version": 0,
            "parameters": {
                "makeConnectionId": 9676638
            },
            "mapper": {
                "files": [],
                "message": "EMAIL ENTRANT\nExpéditeur : {{1.from}}\nObjet : {{1.subject}}\nDate : {{1.date}}\nContenu texte : {{1.text}}\nContenu HTML : {{1.html}}\n\nCALENDRIER\nPériode analysée : {{2.timeMin}} à {{2.timeMax}}\nIntervalles occupés : {{2.result}}",
                "threadId": "{{1.threadId}}",
                "outputType": "text",
                "tokenLimit": "50",
                "modelConfig": {
                    "timeout": "",
                    "recursionLimit": "300",
                    "iterationsFromHistoryCount": "10"
                },
                "defaultModel": "medium",
                "systemPrompt": "Tu es l'agent de qualification et de réponse email d'Abou Diallo.\n\nOBJECTIF\nAnalyser l'email entrant, décider s'il s'agit d'une vraie demande professionnelle, puis préparer une réponse avec des disponibilités réelles issues de Google Calendar.\n\nDEFINITION D'UN LEAD\nUn client potentiel, un recruteur, une opportunité d'emploi/alternance/mission, un partenariat ou une collaboration qui attend raisonnablement une réponse d'Abou.\nNe sont pas des leads : newsletters, promotions, notifications automatiques, reçus, factures, spam, messages no-reply, alertes de plateformes ou conversations personnelles sans demande professionnelle.\n\nREGLES\n1. Si ce n'est pas un lead, réponds exactement : NO_LEAD\n2. Si c'est un lead, rédige une réponse professionnelle, chaleureuse et concise dans la langue de l'email.\n3. Propose exactement 3 créneaux libres de 30 minutes, en semaine, entre 09:00 et 18:00 heure Europe/Paris, dans les 10 prochains jours, au moins 24 heures après maintenant.\n4. Les intervalles fournis par Google Calendar sont des périodes occupées : ne propose jamais un créneau qui les chevauche.\n5. N'invente ni prix, ni engagement, ni information absente. Si la demande nécessite une information inconnue, accuse réception et indique qu'Abou précisera ce point.\n6. Ne dis jamais que tu es une IA ou qu'un automatisme a préparé le message.\n7. Retourne uniquement le corps du brouillon en HTML simple, précédé exactement de LEAD_REPLY:\n8. Termine par : Bien cordialement,<br>Abou Diallo",
                "promptCaching": "none",
                "fallbackEnabled": false
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0,
                    "name": "Qualifier le lead et rédiger la réponse"
                },
                "restore": {
                    "expect": {
                        "files": {
                            "mode": "chose"
                        },
                        "outputType": {
                            "label": "Text"
                        },
                        "defaultModel": {
                            "mode": "chose",
                            "label": "MediumModel: gpt-5-nano. Reasoning: low. A balanced, quick choice for clearly defined tasks needing reliable answers rather than deep analysis"
                        },
                        "promptCaching": {
                            "label": "Automatic (always on)"
                        }
                    },
                    "parameters": {
                        "makeConnectionId": {
                            "data": {
                                "scoped": "true",
                                "connection": "ai-provider"
                            },
                            "label": "abou's Make's AI Provider connection"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "makeConnectionId",
                        "type": "account:ai-provider,openai-gpt-3,anthropic-claude,gemini-ai-q9zyjp,ai-agent-foundry-openai,ai-agent-foundry-non-openai,mistral-ai,cohere,groq,ai-agent-xai,amazon-bedrock,ai-agent-openai-compatible",
                        "label": "Connection",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "defaultModel",
                        "type": "select",
                        "label": "Model",
                        "required": true
                    },
                    {
                        "name": "tokenLimit",
                        "type": "number",
                        "label": "Maximum output length (%)",
                        "validate": {
                            "max": 100,
                            "min": 20
                        }
                    },
                    {
                        "name": "promptCaching",
                        "type": "select",
                        "label": "Prompt caching",
                        "validate": {
                            "enum": [
                                "none"
                            ]
                        }
                    },
                    {
                        "name": "fallbackEnabled",
                        "type": "boolean",
                        "label": "Enable fallback connection",
                        "required": true
                    },
                    {
                        "name": "systemPrompt",
                        "type": "text",
                        "label": "Instructions"
                    },
                    {
                        "name": "message",
                        "type": "text",
                        "label": "Input",
                        "required": true
                    },
                    {
                        "name": "files",
                        "spec": [
                            {
                                "name": "fileName",
                                "type": "filename",
                                "label": "File name",
                                "semantic": "file:name"
                            },
                            {
                                "name": "data",
                                "type": "buffer",
                                "label": "Data",
                                "semantic": "file:data"
                            }
                        ],
                        "type": "array",
                        "label": "Input files"
                    },
                    {
                        "name": "threadId",
                        "type": "text",
                        "label": "Conversation ID",
                        "validate": {
                            "max": 256
                        }
                    },
                    {
                        "name": "modelConfig",
                        "spec": [
                            {
                                "name": "recursionLimit",
                                "type": "number",
                                "label": "Steps per agent call"
                            },
                            {
                                "name": "iterationsFromHistoryCount",
                                "type": "number",
                                "label": "Maximum conversation history"
                            },
                            {
                                "name": "timeout",
                                "type": "number",
                                "label": "Step timeout",
                                "validate": {
                                    "max": 600,
                                    "min": 120
                                }
                            }
                        ],
                        "type": "collection",
                        "label": "Model configuration"
                    },
                    {
                        "name": "outputType",
                        "type": "select",
                        "label": "Response format",
                        "required": true,
                        "validate": {
                            "enum": [
                                "text",
                                "make-schema",
                                "udt-schema"
                            ]
                        }
                    }
                ]
            },
            "tools": []
        },
